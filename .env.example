# Team dev Postgres (via ocha-stratus). Read creds for audits, write creds for refresh.
DSCI_AZ_DB_DEV_HOST=
DSCI_AZ_DB_DEV_UID=
DSCI_AZ_DB_DEV_PW=
DSCI_AZ_DB_DEV_UID_WRITE=
DSCI_AZ_DB_DEV_PW_WRITE=
# Prod read creds only needed for scripts/pcode_audit.py (public.polygon reference)
DSCI_AZ_DB_PROD_HOST=
DSCI_AZ_DB_PROD_UID=
DSCI_AZ_DB_PROD_PW=
PGSSLMODE=require

# HDX HAPI app identifier: base64 of "<app-name>:<email>" (no registration needed)
HAPI_APP_IDENTIFIER=
